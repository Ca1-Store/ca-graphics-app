{
  "name": "ca-graphics-app",
  "version": "2.0.0",
  "description": "CA Store Graphics Installer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "keywords": [],
  "author": "CA Store",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "@electron/fuses": "^1.8.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "cors": "^2.8.6",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.3.4",
    "jsonwebtoken": "^9.0.3",
    "megajs": "^1.3.10",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "node-machine-id": "^1.1.12",
    "pg": "^8.20.0",
    "unzipper": "^0.12.3"
  },
  "build": {
    "appId": "com.castore.graphicsapp",
    "productName": "Ca App",
    "files": [
      "main.js",
      "v4.js",
      "sounds.js",
      "preload.js",
      "lib/**/*",
      "app/**/*",
      "assets/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Ca1-Store",
      "repo": "ca-graphics-app"
    },
    "afterPack": "build/afterPack.js",
    "asar": true
  }
}